{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wahoo Cloud Permissions API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.wahooligan.com/oauth/authorize",
      "accessTokenUrl": "https://api.wahooligan.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Revoke App Access",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.wahooligan.com/v1/permissions",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://api.wahooligan.com/oauth/authorize",
              "accessTokenUrl": "https://api.wahooligan.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Revoke App Access"
        }
      ]
    }
  ],
  "bundled": true
}