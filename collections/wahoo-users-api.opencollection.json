{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wahoo Cloud Permissions Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.wahooligan.com/oauth/authorize",
      "accessTokenUrl": "https://api.wahooligan.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Authenticated User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wahooligan.com/v1/user",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://api.wahooligan.com/oauth/authorize",
              "accessTokenUrl": "https://api.wahooligan.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get Authenticated User"
        },
        {
          "info": {
            "name": "Update Authenticated User",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.wahooligan.com/v1/user",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://api.wahooligan.com/oauth/authorize",
              "accessTokenUrl": "https://api.wahooligan.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Update Authenticated User"
        }
      ]
    }
  ],
  "bundled": true
}